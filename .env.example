# Copy this file to backend/.env and fill in your values.
# Lines marked REQUIRED must be set before the app will start.
# Lines marked OPTIONAL can be left empty to disable that feature.

# ─── Sarvam AI (STT + TTS) ────────────────────────────────────────────────────
# REQUIRED — get your key at: https://console.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=meera

# ─── LLM Providers ────────────────────────────────────────────────────────────
# REQUIRED (primary LLM) — get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# REQUIRED (fallback LLM) — get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# ─── LLM Tracing ──────────────────────────────────────────────────────────────
# OPTIONAL — leave empty to disable; sign up at https://langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─── Twilio (phone + WhatsApp channels) ───────────────────────────────────────
# OPTIONAL — leave empty if you only need the browser WebSocket channel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_strong_random_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
ADMIN_USERNAME=admin
# REQUIRED — choose a strong password
ADMIN_PASSWORD=replace_with_a_strong_password

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ─── App ──────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./vaani.db
AUDIO_STORAGE_DIR=./audio_artifacts
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development

# ─── Pipeline Tuning ──────────────────────────────────────────────────────────
ACTIVE_PROMPT_VERSION=v1
MAX_CONCURRENT_CALLS=10
STT_BUFFER_MS=300
VAD_THRESHOLD=0.5
LANGUAGE_DETECTION_TURNS=1

# ─── Circuit Breaker ──────────────────────────────────────────────────────────
CB_ERROR_THRESHOLD=3
CB_COOLDOWN_SECONDS=60
CB_DISABLE_THRESHOLD=3

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_API=100/minute
RATE_LIMIT_CALLS=30/minute
RATE_LIMIT_AUTH=10/minute
REDIS_URL=redis://redis:6379

# ─── Webhooks ────────────────────────────────────────────────────────────────
FNOL_WEBHOOK_URL=

# ─── Frontend (used by docker-compose) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
