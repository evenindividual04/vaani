# ─── Sarvam AI ────────────────────────────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=meera

# ─── LLM Providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# ─── Langfuse (LLM Tracing) ───────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ─── App ──────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./vaani.db
AUDIO_STORAGE_DIR=./audio_artifacts
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development

# ─── Pipeline Tuning ──────────────────────────────────────────────────────────
ACTIVE_PROMPT_VERSION=v1
MAX_CONCURRENT_CALLS=10
STT_BUFFER_MS=300
VAD_THRESHOLD=0.5
LANGUAGE_DETECTION_TURNS=1

# ─── Circuit Breaker ──────────────────────────────────────────────────────────
CB_ERROR_THRESHOLD=3
CB_COOLDOWN_SECONDS=60
CB_DISABLE_THRESHOLD=3

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_API=100/minute
RATE_LIMIT_CALLS=30/minute
RATE_LIMIT_AUTH=10/minute

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
