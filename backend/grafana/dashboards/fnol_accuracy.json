      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.50, rate(vaani_fnol_completeness_score_bucket[1h]))", "legendFormat": "Completeness P50", "refId": "A"}],
      "title": "FNOL Completeness P50 Trend",
